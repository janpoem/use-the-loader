{
  "name": "use-the-loader",
  "version": "1.0.2",
  "description": "Another React loader hook.",
  "keywords": ["loader", "data-loader", "loader-hook", "hook", "params", "compare"],
  "scripts": {
    "dev:start": "ts-node src/index.ts",
    "test": "mocha",
    "coverage": "nyc npm run test",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "build": "npm run lint && npm run test && npm run rollup",
    "rollup": "rollup -c --bundleConfigAsCjs"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">= 16.0.0"
  },
  "author": "Jiankai Zeng <janpoem@163.com>",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/janpoem/use-the-loader.git"
  },
  "license": "MIT",
  "dependencies": {
    "just-compare": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "typescript": "^5.1.6",
    "eslint": "^8.46.0",
    "@typescript-eslint/parser": "^6.3.0",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "ts-node": "^10.9.1",
    "@swc/cli": "^0.1.62",
    "@swc/core": "^1.3.75",
    "regenerator-runtime": "^0.13.11",
    "mocha": "^10.2.0",
    "@types/mocha": "^10.0.1",
    "chai": "^4.3.7",
    "@types/chai": "^4.3.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.19",
    "@types/react-dom": "^18.2.7",
    "@testing-library/react": "^14.0.0",
    "inject-jsdom": "^1",
    "nyc": "^15.1.0",
    "rollup": "^3.28.0",
    "rollup-plugin-ts": "^3.4.4",
    "@rollup/plugin-commonjs": "^25.0.3",
    "@rollup/plugin-node-resolve": "^15.1.0"
  },
  "peerDependencies": {
    "react": "^16.8.0  || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0  || ^17.0.0 || ^18.0.0"
  }
