{
  "name": "use-the-loader",
  "version": "1.0.9",
  "description": "Another React loader hook.",
  "keywords": [
    "loader",
    "data-loader",
    "loader-hook",
    "hook",
    "params",
    "compare"
  ],
  "scripts": {
    "dev:start": "ts-node src/index.ts",
    "ts-check": "bunx --bun tsc --noEmit",
    "test": "bun test --coverage",
    "lint": "biome lint --error-on-warnings ./src",
    "all-check": "bun run lint && bun run ts-check && bun run test",
    "rollup": "bunx --bun rollup -c rollup.config.ts",
    "build": "bun run all-check && bun run rollup"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "author": "Jiankai Zeng <janpoem@163.com>",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/janpoem/use-the-loader.git"
  },
  "license": "MIT",
  "dependencies": {
    "just-compare": "^2.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2",
    "@biomejs/biome": "^1.9.4",
    "rollup": "^4.34.8",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-plugin-dts": "^6.1.1",
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "react": "^18",
    "react-dom": "^18",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@happy-dom/global-registrator": "^17.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react-hooks": "^8.0.1",
    "react-test-renderer": "^18"
  },
  "peerDependencies": {
    "react": "^16.8.0  || ^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
